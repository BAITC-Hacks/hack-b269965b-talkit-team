{
  "name": "hackalem-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "10.28.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "dev": "concurrently --kill-others -n api,web \"pnpm run dev:api\" \"pnpm run dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch src/server/index.ts",
    "dev:web": "vite --config vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.tools.json",
    "test": "node scripts/test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run typecheck && pnpm test",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.server.build.json && vite build",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "smoke": "node scripts/smoke.mjs",
    "smoke:built": "node scripts/smoke-built.mjs",
    "verify": "pnpm run doctor && pnpm run format:check && pnpm run check && pnpm run build && pnpm run smoke:built",
    "snapshot": "node scripts/snapshot.mjs"
  },
  "dependencies": {
    "h3": "1.15.11",
    "sirv": "3.0.2",
    "zod": "4.3.6",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.9",
    "concurrently": "9.2.4",
    "prettier": "3.8.1",
    "typescript": "6.0.2",
    "vite": "8.2.2",
    "vue-tsc": "3.3.11"
  }
}
